{
  "_readme": [
    "这是占位示例，不会被平台自动加载：必须复制为 platform/config/sources.json，或把环境变量 LGL_SOURCES_CONFIG 指向仓库外的真实配置文件。",
    "base_url 必须替换为你已取得授权的上游接口地址；下方 example-upstream.invalid 是保留占位域名，永远不会连通。",
    "配置里禁止写死令牌：鉴权用 auth_env / headers_env 指向环境变量名，运行时装值。",
    "enabled 保持 false 时，该来源在平台状态为 STUB（可见但不参与真实调用）。",
    "字段映射用点路径；接口返回结构不同只改这里，不要改代码。"
  ],
  "sources": [
    {
      "adapter_id": "aquan_duanju",
      "display_name": "阿圈短剧（示例占位）",
      "media_types": ["drama", "video"],
      "base_url": "https://api.example-upstream.invalid",
      "license": "Apache-2.0",
      "upstream_repo": "https://github.com/wjsqqj/aquan-duanju",
      "enabled": false,
      "auth_env": "LGL_AQUAN_TOKEN",
      "timeout_seconds": 10,
      "max_retries": 1,
      "min_interval_seconds": 1.0,
      "endpoints": {
        "search": {"path": "v1/search", "params": {"q": "{query}", "page": "{page}"}},
        "detail": {"path": "v1/detail/{id}"},
        "episodes": {"path": "v1/detail/{id}/episodes"},
        "resolve": {"path": "v1/play/{id}", "params": {"episode": "{episode}"}}
      },
      "fields": {
        "id": "id",
        "title": "title",
        "cover_url": "cover_url",
        "summary": "summary",
        "author": "author",
        "status": "status",
        "rating": "rating",
        "detail_item_path": "data"
      },
      "search_items_path": "data.items",
      "episodes_path": "data.episodes",
      "resolve_url_field": "data.url",
      "note": "示例占位：必须替换为已授权地址后才可启用。"
    }
  ]
}
